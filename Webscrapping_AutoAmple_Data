library(xml2)
library(RCurl)
library(dplyr)
library(rvest)
library(data.table)
library(tidyverse)




base_url <- "http://www.autoampel.de/typklassen/liste/"
tables <- list()

for (i in seq(1, 100, 9)) {
  # Determine the range of pages to scrape in the current batch
  batch_start <- i
  batch_end <- min(i + 8, 100)
  
  # Loop through each page
  for (page in batch_start:batch_end) {
    # Generate the URL for the current page
    url <- paste0(base_url, page)
    
    # Add a delay of 10 seconds before each request
    Sys.sleep(10)
    
    # Read the HTML content of the page
    webpage <- read_html(url)
    
    # Extract the table from the page
    table <- html_table(webpage)[[2]]
    
    # Add the table to the list
    tables[[page]] <- table
  }
}



combined_dt1 <- rbindlist(tables)
combined_df1 <- as.data.frame(combined_dt1)



